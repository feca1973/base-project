PROJECT_NAME=base_project

HTTP_PORT=8080
PHPMYADMIN_PORT=8081

BACKEND_APP_ENV=dev
BACKEND_APP_DEBUG=1
BACKEND_TZ=Europe/Budapest

MYSQL_INTERNAL_PORT=3306
MYSQL_ROOT_PASSWORD=base_project_root_pass
MYSQL_DATABASE=base_project
MYSQL_USER=base_project_user
MYSQL_PASSWORD=base_project_dev_pass

DATABASE_URL=mysql://base_project_user:base_project_dev_pass@mysql:3306/base_project?serverVersion=8.4.8&charset=utf8mb4
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=no-reply@example.com
APP_FRONTEND_URL=http://localhost:8080
APP_ADMIN_URL=http://localhost:8080/admin
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

PHPMYADMIN_UPLOAD_LIMIT=50M

NUXT_PUBLIC_API_BASE_URL=/api
NUXT_ADMIN_BASE_URL=/admin/
