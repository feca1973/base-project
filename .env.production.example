PROJECT_NAME=base_project

HTTP_PORT=80
PHPMYADMIN_PORT=8081

BACKEND_APP_ENV=prod
BACKEND_APP_DEBUG=0
BACKEND_TZ=Europe/Budapest
APP_SECRET=change-this-production-secret

MYSQL_INTERNAL_PORT=3306
MYSQL_ROOT_PASSWORD=change-this-base-project-root-password
MYSQL_DATABASE=base_project
MYSQL_USER=base_project_user
MYSQL_PASSWORD=change-this-base-project-db-password

DATABASE_URL=mysql://base_project_user:change-this-base-project-db-password@mysql:3306/base_project?serverVersion=8.4.8&charset=utf8mb4
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
APP_FRONTEND_URL=https://example.com
APP_ADMIN_URL=https://admin.example.com
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

PHPMYADMIN_UPLOAD_LIMIT=50M

NUXT_PUBLIC_API_BASE_URL=https://api.example.com/api
NUXT_ADMIN_BASE_URL=/
